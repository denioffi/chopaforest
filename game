-- === Проверки дерева ===
local function hasTrunk(model)
    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower() == "trunkbase" then return v end
    end
    return nil
end

local function isAlive(model)
    for _, v in ipairs(model:GetChildren()) do
        if v.Name == "Top" then return true end
    end
    for _, v in ipairs(model:GetDescendants()) do
        if v.Name == "Top" then return true end
    end
    return false
end

-- === Сбор классов ===
local treeClasses = {}
local classNames = {}

local function scanTrees()
    treeClasses = {}
    for _, model in ipairs(treesFolder:GetChildren()) do
        if model:IsA("Model") then
            local name = model.Name
            if not treeClasses[name] then treeClasses[name] = {} end
            table.insert(treeClasses[name], model)
        end
    end
    classNames = {}
    for name, list in pairs(treeClasses) do
        if #list > 0 then table.insert(classNames, name) end
    end
    table.sort(classNames)
end
scanTrees()

-- === Точка телепорта (лицом к стволу) ===
local function getTeleportCFrame(trunkBase)
    local center = trunkBase.Position
    local angle = math.random() * math.pi * 2
    local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
    local point = center + dir * OFFSET_DISTANCE + Vector3.new(0, HEIGHT_OFFSET, 0)
    local lookTarget = Vector3.new(center.X, point.Y, center.Z)
    return CFrame.lookAt(point, lookTarget)
end

local function faceDirection(look)
    local camera = Workspace.CurrentCamera
    local char = player.Character
    if not camera or not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.01 then return end
    flatLook = flatLook.Unit
    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flatLook)
    local conn, frames = nil, 0
    conn = RunService.RenderStepped:Connect(function()
        frames = frames + 1
        if frames > 15 or not hrp.Parent then conn:Disconnect(); return end
        local camPos = camera.CFrame.Position
        camera.CFrame = CFrame.lookAt(camPos, camPos + flatLook)
    end)
end

-- === Поиск SellSpot (в Map) и SellOutpost (в Workspace) ===
local function collectSellTargets()
    local spots = {}   -- {part=..., kind="SellSpot"/"SellOutpost"}
    if map then
        for _, v in ipairs(map:GetDescendants()) do
            if v:IsA("BasePart") and v.Name == "SellSpot" then
                table.insert(spots, {part = v, kind = "SellSpot"})
            elseif v:IsA("Model") and v.Name == "SellSpot" then
                local p = v:FindFirstChildWhichIsA("BasePart") or v.PrimaryPart
                if p then table.insert(spots, {part = p, kind = "SellSpot"}) end
            end
        end
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name == "SellOutpost" then
            table.insert(spots, {part = v, kind = "SellOutpost"})
        elseif v:IsA("Model") and v.Name == "SellOutpost" then
            local p = v:FindFirstChildWhichIsA("BasePart") or v.PrimaryPart
            if p then table.insert(spots, {part = p, kind = "SellOutpost"}) end
        end
    end
    return spots
end

-- Телепорт к BasePart с учётом высоты и поворота лицом к точке
local function teleportToPart(part)
    if not part or not part.Parent then return false, "нет части" end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "нет персонажа" end

    local point = part.Position + Vector3.new(0, SELL_HEIGHT, 0)
    local flatLook = Vector3.new(part.Position.X - point.X, 0, part.Position.Z - point.Z)
    local cf
    if flatLook.Magnitude > 0.1 then
        cf = CFrame.lookAt(point, point + flatLook.Unit)
    else
        cf = CFrame.new(point)
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hum.AutoRotate = false
    hrp.CFrame = cf
    faceDirection(cf.LookVector)
    task.delay(0.2, function() if hum and hum.Parent then hum.AutoRotate = true end end)
    return true, nil
end

-- Одна кнопка Sell: ищем все SellSpot + SellOutpost, берём ближайшую к игроку
local function teleportToNearestSell()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, "нет персонажа" end
    local myPos = hrp.Position

    local targets = collectSellTargets()
    if #targets == 0 then return false, "SellSpot/SellOutpost не найдены" end

    local best, bestDist, bestKind = nil, math.huge, nil
    for _, t in ipairs(targets) do
        if t.part and t.part.Parent then
            local d = (t.part.Position - myPos).Magnitude
            if d < bestDist then best, bestDist, bestKind = t.part, d, t.kind end
        end
    end
    if not best then return false, "нет валидной точки" end

    local ok, err = teleportToPart(best)
    if ok then
        return true, string.format("%s (%.0f studs)", bestKind, bestDist)
    end
    return false, err
end

