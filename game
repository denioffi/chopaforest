-- === CONFIG ===
local ROOT_NAMES = {"TrunkBase", "Trunk", "TreeBase"}
local OFFSET_DISTANCE = 6

-- === Получаем папку Trees ===
local function getTreesFolder()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    return map:FindFirstChild("Trees")
end

local treesFolder = getTreesFolder()
if not treesFolder then
    warn("[TreeTP] Папка Map/Trees не найдена!")
    return
end

-- === Собираем классы деревьев по имени модели ===
local treeClasses = {}
local function scanTrees()
    treeClasses = {}
    for _, model in ipairs(treesFolder:GetChildren()) do
        if model:IsA("Model") then
            local name = model.Name
            if not treeClasses[name] then
                treeClasses[name] = {}
            end
            table.insert(treeClasses[name], model)
        end
    end
end
