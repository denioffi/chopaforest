local currentDelay = 1.0

local function updateSliderFromValue(value)
    currentDelay = math.clamp(value, MIN_DELAY, MAX_DELAY)
    local ratio = (currentDelay - MIN_DELAY) / (MAX_DELAY - MIN_DELAY)
    sliderFill.Size = UDim2.new(ratio, 0, 1, 0)
    sliderKnob.Position = UDim2.new(ratio, -8, 0.5, -8)
    delayValueLabel.Text = string.format("%.1f s", currentDelay)
end

local sliding = false
local function handleSliderInput(input)
    local relX = input.Position.X - sliderBg.AbsolutePosition.X
    local ratio = math.clamp(relX / sliderBg.AbsoluteSize.X, 0, 1)
    updateSliderFromValue(MIN_DELAY + ratio * (MAX_DELAY - MIN_DELAY))
end

