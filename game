-- Назначаем функцию refreshList (без local, чтобы она перезаписала верхнюю переменную)
refreshList = function()
	cancelCountdown()
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local query = string.lower(searchBox.Text)
	local index = 1
	for _, name in ipairs(getSortedNames()) do
		if query == "" or string.find(string.lower(name), query, 1, true) then
			createListItem(name, index, #classes[name])
			index += 1
		end
	end
end

treesFolderRef.ChildAdded:Connect(function()
	classes = collectTreeClasses()
	refreshList()
end)
treesFolderRef.ChildRemoved:Connect(function()
	classes = collectTreeClasses()
	refreshList()
end)

