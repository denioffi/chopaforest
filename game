local classes = collectTreeClasses()

local function getSortedNames(): { string }
	local names = {}
	for n in pairs(classes) do table.insert(names, n) end
	table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
	return names
end

local function setStatus(text: string, color: Color3?)
	statusLabel.Text = text
	statusLabel.TextColor3 = color or Color3.fromRGB(150, 160, 180)
end

local function getHRP(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function cancelCountdown()
	if activeCountdown then
		local cancel = activeCountdown
		activeCountdown = nil
		cancel()
	end
end

local function returnToSavedPoint()
	if not savedCFrame then
		setStatus("⚠ Нет сохранённой точки", Color3.fromRGB(255, 200, 100))
		return
	end
	local hrp = getHRP()
	if not hrp then
		setStatus("❌ Персонаж не найден", Color3.fromRGB(255, 100, 100))
		return
	end
	hrp.CFrame = savedCFrame
	savedCFrame = nil
	savedClassName = nil
	isAway = false
	setStatus("↩ Возврат выполнен", Color3.fromRGB(120, 220, 140))
	if refreshList then refreshList() end
end

local function startTeleportWithDelay(className: string, onButtonUpdate: ((string) -> ())?)
	local list = classes[className]
	if not list or #list == 0 then
		setStatus("❌ Класс не найден", Color3.fromRGB(255, 100, 100))
		return nil
	end

	local hrp = getHRP()
	if not hrp then
		setStatus("❌ Персонаж не найден", Color3.fromRGB(255, 100, 100))
		return nil
	end

	if isAway and savedClassName == className and savedCFrame then
		returnToSavedPoint()
		return nil
	end

	local valid: { BasePart } = {}
	for _, model in ipairs(list) do
		local base = model:FindFirstChild(TRUNK_BASE_NAME, true)
		if base and base:IsA("BasePart") then
			table.insert(valid, base)
		end
	end
	if #valid == 0 then
		setStatus("❌ Нет TrunkBase в деревьях", Color3.fromRGB(255, 100, 100))
		return nil
	end

	if not isAway then
		savedCFrame = hrp.CFrame
	end

	local cancelled = false
	local remaining = teleportDelay

	local function cancel()
		cancelled = true
		if onButtonUpdate then onButtonUpdate("TP") end
		setStatus("⏹ Телепорт отменён", Color3.fromRGB(255, 200, 100))
	end

	task.spawn(function()
		local lastWhole = math.ceil(remaining)
		while remaining > 0 do
			if cancelled then return end
			local dt = RunService.Heartbeat:Wait()
			remaining -= dt
			local whole = math.max(0, math.ceil(remaining))
			if whole ~= lastWhole and onButtonUpdate then
				onButtonUpdate(whole > 0 and tostring(whole) or "…")
				lastWhole = whole
			end
		end
		if cancelled then return end

		local hrpNow = getHRP()
		if not hrpNow then
			setStatus("❌ Персонаж потерян", Color3.fromRGB(255, 100, 100))
			if onButtonUpdate then onButtonUpdate("TP") end
			return
		end

		local target = valid[math.random(1, #valid)]
		local targetPos = target.Position + TELEPORT_OFFSET
		local oldCF = hrpNow.CFrame
		hrpNow.CFrame = CFrame.new(targetPos, target.Position) * (oldCF - oldCF.Position)

		isAway = true
		savedClassName = className
		setStatus(("✅ У '%s' (%d). Нажми ещё — вернёт"):format(className, #valid), Color3.fromRGB(120, 220, 140))
		if onButtonUpdate then onButtonUpdate("↩ Назад") end
		if refreshList then refreshList() end
	end)

	activeCountdown = function()
		cancelled = true
	end
	return cancel
end

