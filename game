-- === DRAG (мышь + тач, с защитой кнопок) ===
local dragging = false
local dragStart = nil
local startPos = nil

local function isIgnored(obj)
    local cur = obj
    while cur and cur ~= main do
        if cur == closeBtn or cur:IsA("TextButton") or cur:IsA("ImageButton")
            or cur:IsA("ScrollingFrame") then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function startDrag(input)
    dragging = true
    dragStart = input.Position
    startPos = main.Position
end

title.InputBegan:Connect(function(input)
    if isIgnored(input.Target) then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        startDrag(input)
    end
end)

main.InputBegan:Connect(function(input)
    if isIgnored(input.Target) then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        startDrag(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.WindowFocusReleased:Connect(function()
    dragging = false
end)

