-- === Логика телепорта с проверкой Top ===
local function teleportToModel(model)
    if not model or not model.Parent then return false, "нет модели" end
    if not isAlive(model) then return false, "срублено (нет Top)" end
    local trunk = hasTrunk(model)
    if not trunk then return false, "нет TrunkBase" end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false, "нет персонажа" end
    local cf = getTeleportCFrame(trunk)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hum.AutoRotate = false
    hrp.CFrame = cf
    faceDirection(cf.LookVector)
    task.delay(0.2, function() if hum and hum.Parent then hum.AutoRotate = true end end)
    return true, nil
end

local function findNextAlive(direction)
    local list = selectedClass and treeClasses[selectedClass]
    if not list or #list == 0 then return nil end
    local startIdx = selectedIndex
    local idx = selectedIndex
    for _ = 1, #list do
        idx = idx + direction
        if idx > #list then idx = 1 elseif idx < 1 then idx = #list end
        if isAlive(list[idx]) then
            selectedIndex = idx
            return list[idx], idx
        end
    end
    selectedIndex = startIdx
    return nil
end

local function doTeleportNext(direction, isLoop)
    local list = selectedClass and treeClasses[selectedClass]
    if not list or #list == 0 then return false, "Выберите класс!" end
    local targetModel, newIdx = findNextAlive(direction)
    if not targetModel then return false, "Все деревья срублены!" end
    local ok, err = teleportToModel(targetModel)
    if ok then
        local alive = getAliveCount(selectedClass)
        local prefix = isLoop and "[LOOP] " or ""
        statusLabel.Text = string.format("%s%s: %d/%d (Живых: %d)", prefix, selectedClass, selectedIndex, #list, alive)
        return true
    else
        return false, err
    end
end

btnTP.MouseButton1Click:Connect(function()
    if not selectedClass then statusLabel.Text = "Сначала выберите класс!"; return end
    local list = treeClasses[selectedClass]
    if selectedIndex >= 1 and selectedIndex <= #list and isAlive(list[selectedIndex]) then
        local ok, err = teleportToModel(list[selectedIndex])
        if ok then 
            local alive = getAliveCount(selectedClass)
            statusLabel.Text = string.format("%s: %d/%d (Живых: %d)", selectedClass, selectedIndex, #list, alive)
        else statusLabel.Text = "Ошибка: " .. (err or "?") end
    else
        local ok, err = doTeleportNext(1, false)
        if not ok then statusLabel.Text = "Ошибка: " .. (err or "?") end
    end
end)

btnNext.MouseButton1Click:Connect(function()
    if not selectedClass then statusLabel.Text = "Сначала выберите класс!"; return end
    local ok, err = doTeleportNext(1, false)
    if not ok then statusLabel.Text = "Ошибка: " .. (err or "?") end
end)

btnPrev.MouseButton1Click:Connect(function()
    if not selectedClass then statusLabel.Text = "Сначала выберите класс!"; return end
    local ok, err = doTeleportNext(-1, false)
    if not ok then statusLabel.Text = "Ошибка: " .. (err or "?") end
end)

-- === Цикл ===
local looping = false

local function stopLoop()
    looping = false
    btnLoop.Text = "▶ Цикл"
    btnLoop.BackgroundColor3 = Color3.fromRGB(60, 160, 90)
    statusLabel.Text = "Цикл остановлен"
end

btnLoop.MouseButton1Click:Connect(function()
    if looping then stopLoop(); return end
    if not selectedClass then statusLabel.Text = "Сначала выберите класс!"; return end
    looping = true
    btnLoop.Text = "■ Стоп"
    btnLoop.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    task.spawn(function()
        while looping do
            local ok, err = doTeleportNext(1, true)
            if not ok then
                statusLabel.Text = "Цикл прерван: " .. (err or "?")
                stopLoop()
                break
            end
            local t0 = tick()
            while looping and (tick() - t0) < currentDelay do task.wait(0.05) end
        end
    end)
end)

-- === Авто-обновление (слежка за живыми) ===
task.spawn(function()
    while true do
        task.wait(1)
        if not selectedClass then
            rebuildDropdown()
        else
            local alive = getAliveCount(selectedClass)
            dropdownBtn.Text = "  " .. selectedClass .. "  [" .. alive .. "]"
            if dropdownList.Visible then rebuildDropdown() end
        end
    end
end)

-- === Сворачивание и хоткей ===
closeBtn.MouseButton1Click:Connect(function() main.Visible = false; toggleBtn.Visible = true end)
toggleBtn.MouseButton1Click:Connect(function() main.Visible = true; toggleBtn.Visible = false end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
        toggleBtn.Visible = not main.Visible
    end
end)

