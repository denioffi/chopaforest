-- === Логика телепортации ===
local function teleportToModel(model)
    if not model or not model.Parent then return false end
    local point = getTeleportPoint(model)
    if not point then return false end
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local lookAt = (model.PrimaryPart and model.PrimaryPart.Position or point) - point
    lookAt = Vector3.new(lookAt.X, 0, lookAt.Z)
    local cframe
    if lookAt.Magnitude > 0.1 then
        cframe = CFrame.lookAt(point, point + lookAt.Unit)
    else
        cframe = CFrame.new(point)
    end
    hrp.CFrame = cframe
    return true
end

local function getCurrentList()
    if not selectedClass or not treeClasses[selectedClass] then return nil end
    return treeClasses[selectedClass]
end

local function ensureValidIndex()
    local list = getCurrentList()
    if not list or #list == 0 then return false end
    if selectedIndex < 1 then selectedIndex = 1 end
    if selectedIndex > #list then selectedIndex = #list end
    return true
end

local function doTeleport()
    if not ensureValidIndex() then return false end
    local list = treeClasses[selectedClass]
    return teleportToModel(list[selectedIndex])
end

