-- === Цикл ===
local looping = false
local loopThread = nil

local function startLoop()
    if looping then return end
    if not selectedClass then
        statusLabel.Text = "Сначала выберите класс!"
        return
    end
    looping = true
    btnLoop.Text = "■ Стоп"
    btnLoop.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
    loopThread = task.spawn(function()
        while looping do
            local list = getCurrentList()
            if not list or #list == 0 then break end
            selectedIndex = selectedIndex + 1
            if selectedIndex > #list then selectedIndex = 1 end
            if doTeleport() then
                statusLabel.Text = string.format("[LOOP %s] %d/%d", selectedClass, selectedIndex, #list)
            end
            local t0 = tick()
            while looping and (tick() - t0) < currentDelay do
                task.wait(0.05)
            end
        end
    end)
end

local function stopLoop()
    looping = false
    loopThread = nil
    btnLoop.Text = "▶ Цикл"
    btnLoop.BackgroundColor3 = Color3.fromRGB(60, 160, 90)
    statusLabel.Text = "Цикл остановлен"
end

btnLoop.MouseButton1Click:Connect(function()
    if looping then stopLoop() else startLoop() end
end)

