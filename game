        table.insert(classNames, name)
    end
end
table.sort(classNames)

-- === Поиск точки телепорта ===
local function getTeleportPoint(model)
    local basePart = nil
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("BasePart") then
            for _, rootName in ipairs(ROOT_NAMES) do
                if child.Name:lower():find(rootName:lower()) then
                    basePart = child
                    break
                end
            end
            if basePart then break end
        end
    end
    if not basePart then
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") then
                basePart = child
                break
            end
        end
    end
    if not basePart then return nil end

    local pos = basePart.Position
    local look = basePart.CFrame.LookVector
    local point = pos + look * OFFSET_DISTANCE + Vector3.new(0, 3, 0)
    return point
end

