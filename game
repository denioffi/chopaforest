local function findChildCI(parent: Instance, name: string): Instance?
	local direct = parent:FindFirstChild(name)
	if direct then return direct end
	local lower = string.lower(name)
	for _, c in ipairs(parent:GetChildren()) do
		if string.lower(c.Name) == lower then return c end
	end
	return nil
end

local function resolveTreesFolder(): Folder?
	local map = findChildCI(Workspace, MAP_MODEL_NAME)
	if not map then return nil end
	local trees = findChildCI(map, TREES_FOLDER_NAME)
	if trees and trees:IsA("Folder") then return trees end
	return nil
end

local treesFolder = resolveTreesFolder()
if not treesFolder then
	for _ = 1, 50 do
		task.wait(0.2)
		treesFolder = resolveTreesFolder()
		if treesFolder then break end
	end
end

if not treesFolder then
	warn("[TreeTeleporter] Не удалось найти Workspace.Map.Trees.")
	return
end
local treesFolderRef = treesFolder :: Folder

local function collectTreeClasses(): { [string]: { Model } }
	local classes: { [string]: { Model } } = {}
	for _, obj in ipairs(treesFolderRef:GetChildren()) do
		if obj:IsA("Model") then
			classes[obj.Name] = classes[obj.Name] or {}
			table.insert(classes[obj.Name], obj)
		end
	end
	return classes
end

