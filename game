local function setFromInput(inputX: number)
	local absPos = sliderBg.AbsolutePosition.X
	local absSize = sliderBg.AbsoluteSize.X
	local alpha = math.clamp((inputX - absPos) / absSize, 0, 1)
	local raw = DELAY_MIN + alpha * (DELAY_MAX - DELAY_MIN)
	teleportDelay = math.floor(raw / DELAY_STEP + 0.5) * DELAY_STEP
	teleportDelay = math.clamp(teleportDelay, DELAY_MIN, DELAY_MAX)
	updateSliderVisual()
end

